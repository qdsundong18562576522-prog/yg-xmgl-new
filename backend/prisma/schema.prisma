generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ====== 1. 用户与认证 ======

enum UserRole {
  sales
  pm
  purchaser
  finance
  leader
  engineer
  admin
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(128)
  displayName  String    @map("display_name") @db.VarChar(50)
  role         UserRole
  department   String?   @db.VarChar(100)
  phone        String?   @db.VarChar(20)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Inverse relations
  projectsSales              Project[]               @relation("sales")
  projectsManaged            Project[]               @relation("projectManager")
  purchaseRequestsReceiver   PurchaseRequest[]        @relation("PurchaseReceiver")
  purchaseRequestsCreator    PurchaseRequest[]        @relation("PurchaseCreator")
  inquiryOrdersCreator       InquiryOrder[]
  purchaseConfirmsCreator    PurchaseConfirm[]
  deliveryNoticesCreator     DeliveryNotice[]
  stockOutsCreator           StockOut[]
  materialRequisitionsCreator MaterialRequisition[]
  expenseRequestsCreator     ProjectExpenseRequest[]
  reimbursementsCreator      Reimbursement[]
  contractVariationsCreator  ContractVariation[]
  laborContractsCreator      LaborContract[]
  laborVisasCreator          LaborVisa[]
  paymentRequestsCreator     PaymentRequest[]
  receivablesCreator         ProjectReceivable[]
  notifications              Notification[]
  operationLogs              OperationLog[]
  uploadedFiles              File[]
  approvalHistory            ApprovalHistory[]
  projectMembers             ProjectMember[]

  @@map("users")
}

// ====== 2. 项目立项 ======

enum ProjectType {
  integration // 集成
  supply      // 供货
}

enum ProjectStatus {
  draft
  pending
  approved
  rejected
}

model Project {
  id                Int           @id @default(autoincrement())
  code              String        @unique @db.VarChar(50)
  name              String        @db.VarChar(200)
  type              ProjectType
  salesId           Int           @map("sales_id")
  description       String?       @db.Text
  contractAmount    Decimal       @map("contract_amount") @db.Decimal(12, 2)
  expectedProfitRate Decimal?     @map("expected_profit_rate") @db.Decimal(5, 2)
  projectManagerId  Int           @map("project_manager_id")
  planStartDate     DateTime      @map("plan_start_date")
  planEndDate       DateTime      @map("plan_end_date")
  duration          Int?
  remarks           String?       @db.Text
  attachment        String?       @db.Text
  status            ProjectStatus @default(draft)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relations
  sales              User                    @relation("sales", fields: [salesId], references: [id])
  projectManager     User                    @relation("projectManager", fields: [projectManagerId], references: [id])
  purchaseRequests   PurchaseRequest[]
  deliveryNotices    DeliveryNotice[]
  stockIns           StockIn[]
  stockOuts          StockOut[]
  materialRequisitions MaterialRequisition[]
  expenseRequests    ProjectExpenseRequest[]
  reimbursements     Reimbursement[]
  contractVariations ContractVariation[]
  laborContracts     LaborContract[]
  paymentRequests    PaymentRequest[]
  receivables        ProjectReceivable[]
  ledger             ProjectLedger?
  projectInventory   ProjectInventory[]
  costAdjustmentsSource CostAdjustment[]     @relation("costSource")
  costAdjustmentsTarget CostAdjustment[]     @relation("costTarget")
  members            ProjectMember[]

  @@map("projects")
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  userId    Int      @map("user_id")
  role      String   @db.VarChar(20) // 'sales' or 'participant'
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId, role])
  @@map("project_members")
}

// ====== 3. 材料设备库 ======

model MaterialLib {
  id     Int    @id @default(autoincrement())
  name   String @db.VarChar(200)
  brand  String @db.VarChar(100)
  spec   String @map("spec") @db.VarChar(200)
  unit   String @db.VarChar(20)

  purchaseRequestItems      PurchaseRequestItem[]
  inquiryItems              InquiryItem[]
  purchaseConfirmItems      PurchaseConfirmItem[]
  companyInventories        CompanyInventory[]
  deliveryNoticeItems       DeliveryNoticeItem[]
  projectInventories        ProjectInventory[]

  @@unique([name, brand, spec, unit])
  @@map("material_lib")
}

// ====== 4. 采购申请 ======

enum PurchaseRequestStatus {
  draft
  pending
  approved
  rejected
  confirmed // 采购已确认收到
}

model PurchaseRequest {
  id               Int                     @id @default(autoincrement())
  code             String                  @unique @db.VarChar(50)
  projectId        Int                     @map("project_id")
  totalAmount      Decimal                 @map("total_amount") @db.Decimal(12, 2)
  deliveryAddress  String?                 @map("delivery_address") @db.Text
  receiverId       Int?                    @map("receiver_id")
  phone            String?                 @db.VarChar(20)
  status           PurchaseRequestStatus   @default(draft)
  createdById      Int                     @map("created_by")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  project   Project                @relation(fields: [projectId], references: [id])
  receiver  User?                  @relation("PurchaseReceiver", fields: [receiverId], references: [id])
  createdBy User                   @relation("PurchaseCreator", fields: [createdById], references: [id])
  items     PurchaseRequestItem[]
  inquiry   InquiryOrder?

  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                   Int    @id @default(autoincrement())
  prId                 Int    @map("pr_id")
  materialLibId        Int?   @map("material_lib_id")
  name                 String @db.VarChar(200)
  brand                String @db.VarChar(100)
  spec                 String @map("spec") @db.VarChar(200)
  unit                 String @db.VarChar(20)
  quantity             Decimal @db.Decimal(12, 2)
  contractPrice        Decimal @map("contract_price") @db.Decimal(12, 2)
  totalPrice           Decimal @map("total_price") @db.Decimal(12, 2)
  requiredDeliveryDate DateTime? @map("required_delivery_date")
  remark               String? @db.Text

  purchaseRequest PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)
  materialLib     MaterialLib?   @relation(fields: [materialLibId], references: [id])

  @@map("purchase_request_items")
}

// ====== 5. 采购询价 ======

enum InquiryStatus {
  draft
  pending_pm     // 项目经理审批中
  pending_leader // 领导审批中
  approved
  rejected
}

model InquiryOrder {
  id          Int           @id @default(autoincrement())
  code        String        @unique @db.VarChar(50)
  prId        Int           @unique @map("pr_id")
  totalAmount Decimal       @map("total_amount") @db.Decimal(12, 2)
  status      InquiryStatus @default(draft)
  createdById Int           @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  purchaseRequest PurchaseRequest @relation(fields: [prId], references: [id])
  createdBy       User            @relation(fields: [createdById], references: [id])
  items           InquiryItem[]
  purchaseConfirm PurchaseConfirm?

  @@map("inquiry_orders")
}

model InquiryItem {
  id           Int    @id @default(autoincrement())
  inquiryId    Int    @map("inquiry_id")
  materialLibId Int?  @map("material_lib_id")
  name         String @db.VarChar(200)
  brand        String @db.VarChar(100)
  spec         String @map("spec") @db.VarChar(200)
  unit         String @db.VarChar(20)
  quantity     Decimal @db.Decimal(12, 2)
  contractPrice Decimal @map("contract_price") @db.Decimal(12, 2)
  purchasePrice Decimal @map("purchase_price") @db.Decimal(12, 2)
  totalPrice   Decimal @map("total_price") @db.Decimal(12, 2)
  isExtra      Boolean @default(false) @map("is_extra")

  inquiryOrder InquiryOrder @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  materialLib  MaterialLib? @relation(fields: [materialLibId], references: [id])

  @@map("inquiry_items")
}

// ====== 6. 采购确认 ======

enum PurchaseConfirmStatus {
  draft
  pending_pm
  pending_leader
  approved
  rejected
}

model PurchaseConfirm {
  id                  Int                    @id @default(autoincrement())
  code                String                 @unique @db.VarChar(50)
  inquiryId           Int                    @unique @map("inquiry_id")
  deliveryPaymentTerms String?               @map("delivery_payment_terms") @db.Text
  supplyCycle         String?                @map("supply_cycle") @db.VarChar(200)
  contractFile        String?                @map("contract_file") @db.Text
  status              PurchaseConfirmStatus  @default(draft)
  createdById         Int                    @map("created_by")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  inquiryOrder  InquiryOrder          @relation(fields: [inquiryId], references: [id])
  createdBy     User                  @relation(fields: [createdById], references: [id])
  items         PurchaseConfirmItem[]
  deliveryNotices DeliveryNotice[]

  @@map("purchase_confirmations")
}

model PurchaseConfirmItem {
  id           Int    @id @default(autoincrement())
  confirmId    Int    @map("confirm_id")
  materialLibId Int?  @map("material_lib_id")
  name         String @db.VarChar(200)
  brand        String @db.VarChar(100)
  spec         String @map("spec") @db.VarChar(200)
  unit         String @db.VarChar(20)
  quantity     Decimal @db.Decimal(12, 2)
  purchasePrice Decimal @map("purchase_price") @db.Decimal(12, 2)
  totalPrice   Decimal @map("total_price") @db.Decimal(12, 2)

  purchaseConfirm PurchaseConfirm @relation(fields: [confirmId], references: [id], onDelete: Cascade)
  materialLib     MaterialLib?    @relation(fields: [materialLibId], references: [id])

  @@map("purchase_confirm_items")
}

// ====== 7. 公司库存 ======

model CompanyInventory {
  id            Int    @id @default(autoincrement())
  materialLibId Int    @map("material_lib_id")
  quantity      Decimal @default(0) @db.Decimal(12, 2)
  costPrice     Decimal @map("cost_price") @db.Decimal(12, 2)
  remark        String? @db.Text

  materialLib MaterialLib @relation(fields: [materialLibId], references: [id])
  logs        CompanyInventoryLog[]

  @@unique([materialLibId])
  @@map("company_inventory")
}

model CompanyInventoryLog {
  id            Int      @id @default(autoincrement())
  inventoryId   Int      @map("inventory_id")
  changeQty     Decimal  @map("change_qty") @db.Decimal(12, 2)
  type          String   @db.VarChar(20) // in/out
  refId         Int?     @map("ref_id")
  projectId     Int?     @map("project_id")
  costPrice     Decimal  @map("cost_price") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  inventory CompanyInventory @relation(fields: [inventoryId], references: [id])

  @@map("company_inventory_logs")
}

// ====== 8. 供货通知单 ======

enum DeliveryNoticeStatus {
  draft
  pending_purchaser
  pending_leader
  approved
  rejected
}

model DeliveryNotice {
  id               Int                    @id @default(autoincrement())
  code             String                 @unique @db.VarChar(50)
  confirmId        Int                    @unique @map("confirm_id")
  deliveryOption   String?                @map("delivery_option") @db.VarChar(50)
  transportMethod  String?                @map("transport_method") @db.VarChar(30)
  trackingNumber   String?                @map("tracking_number") @db.VarChar(100)
  totalDate        DateTime?              @map("total_date")
  receiver         String?                @db.VarChar(100)
  phone            String?                @db.VarChar(20)
  address          String?                @db.Text
  status           DeliveryNoticeStatus   @default(draft)
  projectId        Int                    @map("project_id")
  createdById      Int                    @map("created_by")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  purchaseConfirm PurchaseConfirm  @relation(fields: [confirmId], references: [id])
  project         Project          @relation(fields: [projectId], references: [id])
  createdBy       User             @relation(fields: [createdById], references: [id])
  items           DeliveryNoticeItem[]
  stockIns        StockIn[]

  @@map("delivery_notices")
}

model DeliveryNoticeItem {
  id              Int      @id @default(autoincrement())
  noticeId        Int      @map("notice_id")
  confirmItemId   Int      @map("confirm_item_id")
  materialLibId   Int?     @map("material_lib_id")
  name            String   @db.VarChar(200)
  brand           String   @db.VarChar(100)
  spec            String   @map("spec") @db.VarChar(200)
  unit            String   @db.VarChar(20)
  quantity        Decimal  @db.Decimal(12, 2)
  purchasePrice   Decimal  @map("purchase_price") @db.Decimal(12, 2)
  deliveryDate    DateTime? @map("delivery_date")

  deliveryNotice DeliveryNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  materialLib    MaterialLib?   @relation(fields: [materialLibId], references: [id])

  @@map("delivery_notice_items")
}

// ====== 9. 项目库存 ======

model ProjectInventory {
  id            Int    @id @default(autoincrement())
  projectId     Int    @map("project_id")
  materialLibId Int    @map("material_lib_id")
  quantity      Decimal @default(0) @db.Decimal(12, 2)
  costPrice     Decimal @map("cost_price") @db.Decimal(12, 2)

  project     Project     @relation(fields: [projectId], references: [id])
  materialLib MaterialLib @relation(fields: [materialLibId], references: [id])

  @@unique([projectId, materialLibId])
  @@map("project_inventory")
}

// ====== 10. 入库单（供货通知审批通过后自动生成） ======

enum StockInStatus {
  auto_generated
  confirmed
}

model StockIn {
  id           Int           @id @default(autoincrement())
  noticeId     Int           @map("notice_id")
  projectId    Int           @map("project_id")
  stockInTime  DateTime      @default(now()) @map("stock_in_time")
  status       StockInStatus @default(auto_generated)
  remark       String?       @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")

  deliveryNotice DeliveryNotice @relation(fields: [noticeId], references: [id])
  project       Project        @relation(fields: [projectId], references: [id])
  items         StockInItem[]

  @@map("stock_ins")
}

model StockInItem {
  id             Int    @id @default(autoincrement())
  stockInId      Int    @map("stock_in_id")
  noticeItemId   Int    @map("notice_item_id")
  materialLibId  Int?   @map("material_lib_id")
  name           String @db.VarChar(200)
  brand          String @db.VarChar(100)
  spec           String @map("spec") @db.VarChar(200)
  unit           String @db.VarChar(20)
  quantity       Decimal @db.Decimal(12, 2)
  costPrice      Decimal @map("cost_price") @db.Decimal(12, 2)

  stockIn StockIn @relation(fields: [stockInId], references: [id], onDelete: Cascade)

  @@map("stock_in_items")
}

// ====== 11. 一键转公司库存（含审批流） ======

enum StockOutStatus {
  draft
  pending_leader
  pending_purchaser
  approved
  rejected
}

enum StockOutReason {
  design_change       // 甲方设计变更
  solution_optimization // 我方方案优化
  procurement_error   // 采购数量提报错误
  other               // 其他
}

model StockOut {
  id           Int             @id @default(autoincrement())
  projectId    Int             @map("project_id")
  reasonType   StockOutReason  @map("reason_type")
  reasonDetail String?         @map("reason_detail") @db.Text
  status       StockOutStatus  @default(draft)
  createdById  Int             @map("created_by")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  project  Project         @relation(fields: [projectId], references: [id])
  createdBy User            @relation(fields: [createdById], references: [id])
  items     StockOutItem[]
  costAdjustments CostAdjustment[]

  @@map("stock_outs")
}

model StockOutItem {
  id            Int    @id @default(autoincrement())
  outId         Int    @map("out_id")
  materialLibId Int?   @map("material_lib_id")
  name          String @db.VarChar(200)
  brand         String @db.VarChar(100)
  spec          String @map("spec") @db.VarChar(200)
  unit          String @db.VarChar(20)
  quantity      Decimal @db.Decimal(12, 2)
  costPrice     Decimal @map("cost_price") @db.Decimal(12, 2)
  costTotal     Decimal @map("cost_total") @db.Decimal(12, 2)

  stockOut StockOut @relation(fields: [outId], references: [id], onDelete: Cascade)

  @@map("stock_out_items")
}

// ====== 12. 材料设备领用单 ======

enum RequisitionStatus {
  draft
  pending_purchaser
  pending_leader
  approved
  rejected
}

model MaterialRequisition {
  id          Int                @id @default(autoincrement())
  projectId   Int                @map("project_id")
  totalCost   Decimal            @map("total_cost") @db.Decimal(12, 2)
  status      RequisitionStatus  @default(draft)
  createdById Int                @map("created_by")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  project  Project                     @relation(fields: [projectId], references: [id])
  createdBy User                        @relation(fields: [createdById], references: [id])
  items     MaterialRequisitionItem[]
  costAdjustments CostAdjustment[]

  @@map("material_requisitions")
}

model MaterialRequisitionItem {
  id             Int    @id @default(autoincrement())
  requisitionId  Int    @map("requisition_id")
  materialLibId  Int?   @map("material_lib_id")
  name           String @db.VarChar(200)
  brand          String @db.VarChar(100)
  spec           String @map("spec") @db.VarChar(200)
  unit           String @db.VarChar(20)
  quantity       Decimal @db.Decimal(12, 2)
  costPrice      Decimal @map("cost_price") @db.Decimal(12, 2)
  contractPrice  Decimal @map("contract_price") @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  requisition MaterialRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@map("material_requisition_items")
}

// ====== 13. 成本调整记录 ======

model CostAdjustment {
  id                Int      @id @default(autoincrement())
  sourceProjectId   Int      @map("source_project_id")
  targetProjectId   Int      @map("target_project_id")
  stockOutId        Int?     @map("stock_out_id")
  requisitionId     Int?     @map("requisition_id")
  amount            Decimal  @db.Decimal(12, 2)
  status            String   @default("pending") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at")

  sourceProject Project @relation("costSource", fields: [sourceProjectId], references: [id])
  targetProject Project @relation("costTarget", fields: [targetProjectId], references: [id])
  stockOut      StockOut? @relation(fields: [stockOutId], references: [id])
  requisition   MaterialRequisition? @relation(fields: [requisitionId], references: [id])

  @@map("cost_adjustments")
}

// ====== 14. 项目费用申请 ======

enum ExpenseRequestStatus {
  draft
  pending_leader
  pending_finance
  approved
  rejected
}

model ProjectExpenseRequest {
  id          Int                   @id @default(autoincrement())
  projectId   Int                   @map("project_id")
  reason      String                @db.Text
  amount      Decimal               @db.Decimal(12, 2)
  payMethod   String                @map("pay_method") @db.VarChar(50)
  otherMethod String?               @map("other_method") @db.VarChar(100)
  status      ExpenseRequestStatus  @default(draft)
  createdById Int                   @map("created_by")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  project   Project @relation(fields: [projectId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@map("project_expense_requests")
}

// ====== 15. 报销 ======

enum ReimbursementStatus {
  draft
  pending_pm
  pending_leader
  pending_finance
  approved
  rejected
}

model Reimbursement {
  id             Int                  @id @default(autoincrement())
  projectId      Int                  @map("project_id")
  reason         String               @db.Text
  amount         Decimal              @db.Decimal(12, 2)
  hasInvoice     Boolean              @default(false) @map("has_invoice")
  invoiceFile    String?              @map("invoice_file") @db.Text
  noInvoiceReason String?             @map("no_invoice_reason") @db.Text
  status         ReimbursementStatus  @default(draft)
  needsPmApprove Boolean              @default(true) @map("needs_pm_approve")
  createdById    Int                  @map("created_by")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  project   Project @relation(fields: [projectId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@map("reimbursements")
}

// ====== 16. 工程量变更 ======

enum VariationStatus {
  draft
  pending
  approved
  rejected
}

model ContractVariation {
  id          Int             @id @default(autoincrement())
  projectId   Int             @map("project_id")
  status      VariationStatus @default(draft)
  createdById Int             @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  project   Project          @relation(fields: [projectId], references: [id])
  createdBy User              @relation(fields: [createdById], references: [id])
  items     VariationItem[]

  @@map("contract_variations")
}

model VariationItem {
  id            Int    @id @default(autoincrement())
  variationId   Int    @map("variation_id")
  materialLibId Int?   @map("material_lib_id")
  name          String @db.VarChar(200)
  brand         String @db.VarChar(100)
  spec          String @map("spec") @db.VarChar(200)
  unit          String @db.VarChar(20)
  quantity      Decimal @db.Decimal(12, 2)
  contractPrice Decimal @map("contract_price") @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  variation ContractVariation @relation(fields: [variationId], references: [id], onDelete: Cascade)

  @@map("variation_items")
}

// ====== 17. 劳务合同 ======

enum LaborContractStatus {
  draft
  pending_pm
  pending_leader
  approved
  rejected
}

model LaborContract {
  id            Int                 @id @default(autoincrement())
  projectId     Int                 @map("project_id")
  amount        Decimal             @db.Decimal(12, 2)
  contractFile  String?             @map("contract_file") @db.Text
  status        LaborContractStatus @default(draft)
  createdById   Int                 @map("created_by")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  project   Project     @relation(fields: [projectId], references: [id])
  createdBy User         @relation(fields: [createdById], references: [id])
  visas     LaborVisa[]

  @@map("labor_contracts")
}

// ====== 18. 劳务签证 ======

enum LaborVisaStatus {
  draft
  pending
  approved
  rejected
}

model LaborVisa {
  id              Int             @id @default(autoincrement())
  laborContractId Int             @map("labor_contract_id")
  reasonCalc      String          @map("reason_calc") @db.Text
  amountChange    Decimal         @map("amount_change") @db.Decimal(12, 2)
  status          LaborVisaStatus @default(draft)
  createdById     Int             @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  laborContract LaborContract @relation(fields: [laborContractId], references: [id])
  createdBy     User          @relation(fields: [createdById], references: [id])

  @@map("labor_visas")
}

// ====== 19. 付款申请 ======

enum PaymentRequestStatus {
  draft
  pending_leader
  pending_finance
  approved
  rejected
}

model PaymentRequest {
  id           Int                  @id @default(autoincrement())
  projectId    Int                  @map("project_id")
  contractType String               @map("contract_type") @db.VarChar(20)
  contractId   Int                  @map("contract_id")
  paymentTerms String?              @map("payment_terms") @db.Text
  reason       String               @db.Text
  amount       Decimal              @db.Decimal(12, 2)
  status       PaymentRequestStatus @default(draft)
  createdById  Int                  @map("created_by")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  project       Project              @relation(fields: [projectId], references: [id])
  createdBy     User                  @relation(fields: [createdById], references: [id])
  confirmations PaymentConfirmation[]

  @@map("payment_requests")
}

// ====== 20. 付款确认 ======

model PaymentConfirmation {
  id                Int      @id @default(autoincrement())
  paymentRequestId  Int      @unique @map("payment_request_id")
  amount            Decimal  @db.Decimal(12, 2)
  paymentTime       DateTime @default(now()) @map("payment_time")
  createdAt         DateTime @default(now()) @map("created_at")

  paymentRequest PaymentRequest @relation(fields: [paymentRequestId], references: [id])

  @@map("payment_confirmations")
}

// ====== 21. 项目回款 ======

model ProjectReceivable {
  id           Int      @id @default(autoincrement())
  projectId    Int      @map("project_id")
  amount       Decimal  @db.Decimal(12, 2)
  method       String   @db.VarChar(50)
  receivedTime DateTime @default(now()) @map("received_time")
  createdById  Int      @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  project   Project @relation(fields: [projectId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@map("project_receivables")
}

// ====== 22. 项目台账 ======

model ProjectLedger {
  id                      Int     @id @default(autoincrement())
  projectId               Int     @unique @map("project_id")
  contractAmount          Decimal @default(0) @map("contract_amount") @db.Decimal(12, 2)
  variationAmount         Decimal @default(0) @map("variation_amount") @db.Decimal(12, 2)
  adjustedAmount          Decimal @default(0) @map("adjusted_amount") @db.Decimal(12, 2)
  totalReceivable         Decimal @default(0) @map("total_receivable") @db.Decimal(12, 2)
  totalPaidOut            Decimal @default(0) @map("total_paid_out") @db.Decimal(12, 2)
  purchaseCost            Decimal @default(0) @map("purchase_cost") @db.Decimal(12, 2)
  laborCost               Decimal @default(0) @map("labor_cost") @db.Decimal(12, 2)
  expenseCost             Decimal @default(0) @map("expense_cost") @db.Decimal(12, 2)
  requisitionCost         Decimal @default(0) @map("requisition_cost") @db.Decimal(12, 2)
  stockOutPendingDeduct   Decimal @default(0) @map("stock_out_pending_deduct") @db.Decimal(12, 2)
  deductedByOtherProjects Decimal @default(0) @map("deducted_by_other_projects") @db.Decimal(12, 2)
  otherDeduction          Decimal @default(0) @map("other_deduction") @db.Decimal(12, 2)
  totalCost               Decimal @default(0) @map("total_cost") @db.Decimal(12, 2)
  profit                  Decimal @default(0) @db.Decimal(12, 2)
  profitRate              Decimal @default(0) @map("profit_rate") @db.Decimal(5, 2)
  updatedAt               DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id])

  @@map("project_ledgers")
}

// ====== 23. 通知系统 ======

model Notification {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  type           String   @db.VarChar(50)
  title          String   @db.VarChar(200)
  content        String?  @db.Text
  entityType     String?  @map("entity_type") @db.VarChar(50)
  entityId       Int?     @map("entity_id")
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

// ====== 24. 操作日志 ======

model OperationLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  userName   String   @map("user_name") @db.VarChar(50)
  action     String   @db.VarChar(20)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   Int      @map("entity_id")
  changes    String?  @db.Text // JSON
  ipAddress  String?  @map("ip_address") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@map("operation_logs")
}

// ====== 25. 文件管理 ======

model File {
  id           Int      @id @default(autoincrement())
  originalName String   @map("original_name") @db.VarChar(255)
  storedPath   String   @map("stored_path") @db.Text
  mimeType     String?  @map("mime_type") @db.VarChar(100)
  size         Int?
  entityType   String?  @map("entity_type") @db.VarChar(50)
  entityId     Int?     @map("entity_id")
  uploadedById Int?     @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@map("files")
}

// ====== 26. 审批历史 ======

model ApprovalHistory {
  id         Int      @id @default(autoincrement())
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   Int      @map("entity_id")
  step       Int
  approverId Int      @map("approver_id")
  action     String   @db.VarChar(10) // approve / reject
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  approver User @relation(fields: [approverId], references: [id])

  @@index([entityType, entityId])
  @@map("approval_history")
}

// ====== 27. 项目库存流水 ======

model ProjectInventoryLog {
  id            Int      @id @default(autoincrement())
  inventoryId   Int      @map("inventory_id")
  changeQty     Decimal  @map("change_qty") @db.Decimal(12, 2)
  type          String   @db.VarChar(20) // in/out
  refId         Int?     @map("ref_id")
  costPrice     Decimal  @map("cost_price") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("project_inventory_logs")
}
